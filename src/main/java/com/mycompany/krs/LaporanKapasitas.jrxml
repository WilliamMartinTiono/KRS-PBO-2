                <reportElement x="135" y="0" width="140" height="20" uuid="77777777-7777-7777-7777-777777777772"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Dosen]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="0" width="100" height="20" uuid="77777777-7777-7777-7777-777777777773"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Waktu]]></text>
            </staticText>
            <staticText>
                <reportElement x="375" y="0" width="60" height="20" uuid="77777777-7777-7777-7777-777777777774"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Kuota]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="60" height="20" uuid="77777777-7777-7777-7777-777777777775"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Terisi]]></text>
            </staticText>
            <staticText>
                <reportElement x="495" y="0" width="60" height="20" uuid="77777777-7777-7777-7777-777777777776"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Sisa]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="135" height="20" uuid="88888888-8888-8888-8888-888888888881"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nama_mk}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="135" y="0" width="140" height="20" uuid="88888888-8888-8888-8888-888888888882"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nama_dosen}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="275" y="0" width="100" height="20" uuid="88888888-8888-8888-8888-888888888883"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{hari} + ", " + $F{jam}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="375" y="0" width="60" height="20" uuid="88888888-8888-8888-8888-888888888884"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{kuota} + ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="435" y="0" width="60" height="20" uuid="88888888-8888-8888-8888-888888888885"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{terisi} + ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="495" y="0" width="60" height="20" uuid="88888888-8888-8888-8888-888888888886"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[($F{kuota}.intValue() - $F{terisi}.intValue()) + ""]]></textFieldExpression>
            </textField>
        </band>
    </detail>
