<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CetakKrsBimbingan" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="abcdef12-3456-7890-abcd-ef1234567890">
    <parameter name="p_nim" class="java.lang.String"/>
    <parameter name="p_id_periode" class="java.lang.String"/>
    <parameter name="p_nidn_dosen" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT k.nim, m.nama_mhs, p.semester, p.tahun_ajaran, k.status_validasi, 
                        mk.kode_mk, mk.nama_mk, mk.sks, kd.status_detail 
                 FROM krs_header k 
                 JOIN mahasiswa m ON k.nim = m.nim
                 JOIN periode p ON k.id_periode = p.id_periode
                 JOIN krs_detail kd ON k.id_krs = kd.id_krs
                 JOIN kelas kl ON kd.id_kelas = kl.id_kelas
                 JOIN mata_kuliah mk ON kl.kode_mk = mk.kode_mk
                 WHERE k.nim = $P{p_nim} 
                 AND k.id_periode = $P{p_id_periode} 
                 AND m.id_dosen_wali = $P{p_nidn_dosen}]]>
    </queryString>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_mhs" class="java.lang.String"/>
    <field name="semester" class="java.lang.String"/>
    <field name="tahun_ajaran" class="java.lang.String"/>
    <field name="status_validasi" class="java.lang.String"/>
    <field name="kode_mk" class="java.lang.String"/>
    <field name="nama_mk" class="java.lang.String"/>
    <field name="sks" class="java.lang.Integer"/>
    <field name="status_detail" class="java.lang.String"/>
    <title>
        <band height="60" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30" uuid="11111111-2222-3333-4444-555555555555"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[KRS MAHASISWA BIMBINGAN]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="555" height="20" uuid="22222222-3333-4444-5555-666666666666"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["NIM: " + $F{nim} + " | Nama: " + $F{nama_mhs}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="20" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="100" height="20" uuid="33333333-4444-5555-6666-777777777777"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Kode MK]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="255" height="20" uuid="44444444-5555-6666-7777-888888888888"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Nama Mata Kuliah]]></text>
            </staticText>
            <staticText>
                <reportElement x="355" y="0" width="50" height="20" uuid="55555555-6666-7777-8888-999999999999"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[SKS]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="150" height="20" uuid="66666666-7777-8888-9999-000000000000"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Status Validasi]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="100" height="20" uuid="77777777-8888-9999-0000-111111111111"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{kode_mk}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="0" width="255" height="20" uuid="88888888-9999-0000-1111-222222222222"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nama_mk}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="0" width="50" height="20" uuid="99999999-0000-1111-2222-333333333333"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{sks} + ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="0" width="150" height="20" uuid="00000000-1111-2222-3333-444444444444"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status_detail}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>