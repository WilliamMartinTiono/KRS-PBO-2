<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LaporanRuang" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="99999999-9999-9999-9999-999999999999">
    <parameter name="p_id_periode" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT k.hari, k.jam, k.ruang, mk.nama_mk, d.nama_dosen 
                 FROM kelas k JOIN mata_kuliah mk ON k.kode_mk = mk.kode_mk JOIN dosen d ON k.nidn = d.nidn 
                 WHERE k.id_periode = $P{p_id_periode} 
                 ORDER BY FIELD(k.hari,'Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'), k.jam]]>
    </queryString>
    <field name="hari" class="java.lang.String"/>
    <field name="jam" class="java.lang.String"/>
    <field name="ruang" class="java.lang.String"/>
    <field name="nama_mk" class="java.lang.String"/>
    <field name="nama_dosen" class="java.lang.String"/>
