<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LaporanBelumKrs" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="11111111-1111-1111-1111-111111111111">
    <parameter name="p_id_periode" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT m.nim, m.nama_mhs, d.nama_dosen AS dosen_wali 
                 FROM mahasiswa m 
                 LEFT JOIN dosen d ON m.id_dosen_wali = d.nidn 
                 WHERE m.nim NOT IN (SELECT nim FROM krs_header WHERE id_periode = $P{p_id_periode} AND nim IS NOT NULL) 
                 ORDER BY m.nama_mhs]]>
    </queryString>
    <field name="nim" class="java.lang.String"/>
    <field name="nama_mhs" class="java.lang.String"/>
    <field name="dosen_wali" class="java.lang.String"/>
    <title>
        <band height="60" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30" uuid="22222222-2222-2222-2222-222222222222"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN MAHASISWA BELUM MENGISI KRS]]></text>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="20" splitType="Stretch">
