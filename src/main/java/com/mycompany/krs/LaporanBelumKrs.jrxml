                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nama_mhs}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="0" width="200" height="20" uuid="44444444-4444-4444-4444-444444444443"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{dosen_wali} == null ? "-" : $F{dosen_wali}]]></textFieldExpression>
